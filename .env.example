# ---- docker compose (root) --------------------------------------------------
POSTGRES_USER=hws
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hirewithsense
JWT_SECRET=replace-with-at-least-32-random-characters-please
PUBLIC_WEB_URL=http://localhost:8080
WEB_PORT=8080

# AI: 'mock' works offline; 'openai_compatible' needs a key. Any OpenAI-compatible endpoint works:
#   OpenAI:    AI_BASE_URL unset,                                   AI_MODEL=gpt-4.1-mini
#   Gemini:    AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.5-flash
#   DashScope: AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1    AI_MODEL=qwen-plus
#   Groq:      AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=llama-3.3-70b-versatile
#   Ollama:    AI_BASE_URL=http://host.docker.internal:11434/v1                      AI_MODEL=llama3.1
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_ENABLE_AUDIO=false

# Speech for voice interviews (transcription + text-to-speech), independent of the model above.
# Free, self-hosted: start the bundled engine with `docker compose --profile speech up -d` and use:
#   SPEECH_PROVIDER=openai_compatible
#   SPEECH_BASE_URL=http://speaches:8000/v1
#   SPEECH_STT_MODEL=Systran/faster-whisper-small
#   SPEECH_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
#   SPEECH_TTS_VOICE=af_heart
# OpenAI: SPEECH_PROVIDER=openai_compatible, SPEECH_API_KEY=sk-..., leave SPEECH_BASE_URL empty.
SPEECH_PROVIDER=none
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_STT_MODEL=gpt-4o-mini-transcribe
SPEECH_TTS_MODEL=gpt-4o-mini-tts
SPEECH_TTS_VOICE=coral
SPEECH_TTS_FORMAT=mp3

# Code execution. 'judge0' for hosted deployments (RapidAPI or self-hosted), 'docker' when the API host
# runs Docker (uses ephemeral sandbox containers), 'none' disables the IDE run/submit.
CODE_RUNNER=judge0
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_AUTH_TOKEN=

# Email. 'outbox' stores mail in the database (visible at /dev/outbox in development); 'smtp' sends.
EMAIL_TRANSPORT=outbox
EMAIL_FROM=HireWithSense <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# File storage: 'local' (volume) or 's3' (install @aws-sdk/client-s3 in apps/api).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Comma-separated emails that get the superadmin role on registration.
SUPERADMIN_EMAILS=
