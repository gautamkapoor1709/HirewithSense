# Local development for the API (copy to apps/api/.env)
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgres://hws:hws@localhost:5433/hirewithsense
JWT_SECRET=dev-only-secret-change-me-please-0123456789abcdef
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Offline-friendly defaults: deterministic AI, Docker sandbox, database mailbox.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_ENABLE_AUDIO=false

# Voice interviews need a speech engine unless the candidate's browser provides one (Chrome on
# Windows/macOS does; Linux and Brave/Chromium usually do not). Free local option:
#   docker run -d --name hws-speaches -p 8000:8000 -e ENABLE_UI=false \
#     -v hf-hub-cache:/home/ubuntu/.cache/huggingface/hub ghcr.io/speaches-ai/speaches:latest-cpu
#   ./scripts/speech-models.sh            # downloads the two models (about 1 GB, once)
# then set:
#   SPEECH_PROVIDER=openai_compatible
#   SPEECH_BASE_URL=http://localhost:8000/v1
#   SPEECH_STT_MODEL=Systran/faster-whisper-small
#   SPEECH_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
#   SPEECH_TTS_VOICE=af_heart
SPEECH_PROVIDER=none
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_STT_MODEL=gpt-4o-mini-transcribe
SPEECH_TTS_MODEL=gpt-4o-mini-tts
SPEECH_TTS_VOICE=coral
CODE_RUNNER=docker
EMAIL_TRANSPORT=outbox
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
